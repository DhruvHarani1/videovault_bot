# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_dummykeyid123
RAZORPAY_KEY_SECRET=dummykeysecret456789

# Database URL for SQLite with async support
DATABASE_URL=sqlite+aiosqlite:///./data/videovault.db

# Comma-separated list of Telegram User IDs who are admins
ADMIN_USER_IDS=123456789,987654321

# Video Preview duration in seconds (default: 180)
VIDEO_PREVIEW_SECONDS=180

# Price of the full video in INR (default: 299)
FULL_VIDEO_PRICE_INR=299

# Public HTTPS URL for webhook (optional for development, required for production)
WEBHOOK_URL=

# Full video Telegram file_id (or video URL during development)
FULL_VIDEO_FILE_ID=https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/one-by-one-person-detection.mp4

# Razorpay Webhook Secret for signature validation
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_123

# Telegram Webhook Secret Token to prevent fake requests
WEBHOOK_SECRET_TOKEN=default_secret_token_123

# Gmail SMTP credentials for email alerts
ALERT_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# UptimeRobot contact ID for downtime alerts
UPTIMEROBOT_ALERT_CONTACT_ID=12345


