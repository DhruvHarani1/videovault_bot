# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_dummykeyid123
RAZORPAY_KEY_SECRET=dummykeysecret456789

# Database URL for SQLite with async support
DATABASE_URL=sqlite+aiosqlite:///./data/videovault.db

# Comma-separated list of Telegram User IDs who are admins
ADMIN_USER_IDS=123456789,987654321

# Video Preview duration in seconds (default: 180)
VIDEO_PREVIEW_SECONDS=180

# Price of the full video in INR (default: 299)
FULL_VIDEO_PRICE_INR=299

# Public HTTPS URL for webhook (optional for development, required for production)
WEBHOOK_URL=

# Full video Telegram file_id (or video URL during development)
FULL_VIDEO_FILE_ID=https://raw.githubusercontent.com/intel-iot-devkit/sample-videos/master/one-by-one-person-detection.mp4

# Razorpay Webhook Secret for signature validation
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret_123

# Telegram Webhook Secret Token to prevent fake requests
WEBHOOK_SECRET_TOKEN=default_secret_token_123

# Gmail SMTP credentials for email alerts
ALERT_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# UptimeRobot contact ID for downtime alerts
UPTIMEROBOT_ALERT_CONTACT_ID=12345

# ──────────────────────────────────────────────────────────────────────────────
# Phase 0 — Multi-bot ecosystem (all optional until later phases use them)
# Role → handle:  Sales=@muthalsamajhbot  Demo=@lookatthedemobot
#                 Payment=@videovault693bot (current BOT_TOKEN)  File=(new bot)
# ──────────────────────────────────────────────────────────────────────────────

# Bot tokens from @BotFather. PAYMENT_BOT_TOKEN defaults to BOT_TOKEN if left blank.
SALES_BOT_TOKEN=
DEMO_BOT_TOKEN=
PAYMENT_BOT_TOKEN=
FILE_BOT_TOKEN=

# Bot usernames (without @) — used to build t.me deep links between bots.
SALES_BOT_USERNAME=muthalsamajhbot
DEMO_BOT_USERNAME=lookatthedemobot
PAYMENT_BOT_USERNAME=videovault693bot
FILE_BOT_USERNAME=

# Per-bot webhook secret tokens (optional; default to WEBHOOK_SECRET_TOKEN).
SALES_WEBHOOK_SECRET=
DEMO_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_SECRET=
FILE_WEBHOOK_SECRET=

# Payment QR / UPI image (Telegram file_id or image URL) served by the Payment Bot.
PAYMENT_QR_FILE_ID=

# Demo content expiry in seconds (Demo Bot). Default 200.
DEMO_EXPIRY_SECONDS=200

# Comma-separated alert recipients. Falls back to ALERT_EMAIL if empty.
ALERT_EMAILS=

